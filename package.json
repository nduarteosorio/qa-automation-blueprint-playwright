{
  "name": "qa-automation-blueprint-playwright",
  "version": "1.0.0",
  "description": "Enterprise-grade test automation framework built with Playwright + TypeScript, designed for scalability, maintainability, and real-world QA challenges.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nduarteosorio/qa-automation-blueprint-playwright.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nduarteosorio/qa-automation-blueprint-playwright/issues"
  },
  "homepage": "https://github.com/nduarteosorio/qa-automation-blueprint-playwright#readme",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
